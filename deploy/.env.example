# Production environment for /srv/traveller/.env — copy to `.env` and fill in.
# This single file is loaded by BOTH the api and web containers (env_file).
# Never commit the real .env; keep secrets out of git.

# ── Postgres (internal service) ──────────────────────────────────────────────
# POSTGRES_* configure the postgres container; DATABASE_URL must match them and
# point at the compose service hostname `postgres`.
POSTGRES_USER=traveller
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=traveller
DATABASE_URL=postgresql://traveller:CHANGE_ME_STRONG_RANDOM@postgres:5432/traveller

# ── Redis (internal service) ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Secret used to sign JWT access tokens. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Public base URL of the API, INCLUDING the /api prefix (Caddy forwards
# /api/* to traveller-api with the path preserved).
API_URL=https://traveller.shvedov.tech/api

# The web origin — CORS allow-list and the post-login redirect target.
WEB_ORIGIN=https://traveller.shvedov.tech

# Behind Caddy → trust one proxy hop so req.ip (rate limiting) is the real IP.
TRUST_PROXY=true

# ── Web (SSR / metadata) ─────────────────────────────────────────────────────
# API origin as seen from the Next server (internal network alias). The /api
# prefix is appended in code, so no suffix here.
API_INTERNAL_URL=http://traveller-api:4000

# Public site origin for OG images + share links (metadataBase). NOTE: this is
# also inlined into the web image at BUILD time (build-arg) — keep them equal.
NEXT_PUBLIC_SITE_URL=https://traveller.shvedov.tech

# ── SMTP for magic-link email (Resend recommended) ───────────────────────────
# Resend: host smtp.resend.com, port 465 (SMTP_SECURE=true), user "resend",
#         pass = your Resend API key (re_...).
# Brevo:  host smtp-relay.brevo.com, port 587, user = login, pass = SMTP key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_CHANGE_ME_resend_api_key
# From header — must be a verified sender/domain in your provider.
MAIL_FROM=Traveller <login@traveller.shvedov.tech>

# ── Google OAuth (optional — leave blank to disable the button) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://traveller.shvedov.tech/api/auth/google/callback

# ── Magic-link anti-abuse caps (optional overrides) ──────────────────────────
# MAGIC_LINK_IP_MAX=5
# MAGIC_LINK_EMAIL_DAILY_MAX=10
# MAGIC_LINK_IP_DAILY_MAX=20
# MAGIC_LINK_GLOBAL_DAILY_MAX=200

# Same-origin deployment → no cookie domain needed (host-only cookies).
COOKIE_DOMAIN=
