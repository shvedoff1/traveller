# ── API ──────────────────────────────────────────────────────────────────────

# Port the NestJS API listens on.
PORT=4000

# Public base URL of the API — used to build magic-link verify URLs.
API_URL=http://localhost:4000

# Origin allowed by CORS (the web app). Cookies are scoped to this origin.
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection string (docker-compose postgres service). Required.
DATABASE_URL=postgresql://traveller:traveller@localhost:5432/traveller

# Redis connection string (throttling + cache-aside). Required.
REDIS_URL=redis://localhost:6379

# Secret used to sign JWT access tokens. Required.
JWT_SECRET=change-me-in-production

# Google OAuth credentials. Optional in dev: the Google strategy only
# registers when GOOGLE_CLIENT_ID is set; magic links are the fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:4000/auth/google/callback

# SMTP for magic-link emails. In dev this is Mailpit (UI at :8025), which
# needs no auth. For production point these at a real provider:
#   Resend  → host smtp.resend.com, user "resend",  pass = your API key
#   Brevo   → host smtp-relay.brevo.com, user = login, pass = SMTP key
# SMTP_USER/SMTP_PASS are all-or-nothing (boot fails if only one is set).
# SMTP_SECURE=true forces implicit TLS (port 465); leave false for 587/STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# From header for outgoing mail. Falls back to a dev default when unset.
MAIL_FROM=

# Magic-link anti-abuse caps (Redis fixed windows). Per-email 3/15min is
# fixed; these are the tunable per-IP and daily ceilings. The global daily
# cap protects the SMTP provider quota — over it, sends are silently skipped.
MAGIC_LINK_IP_MAX=5
MAGIC_LINK_EMAIL_DAILY_MAX=10
MAGIC_LINK_IP_DAILY_MAX=20
MAGIC_LINK_GLOBAL_DAILY_MAX=200

# Domain for auth cookies. Leave empty in dev (host-only cookies).
COOKIE_DOMAIN=

# ── Web ──────────────────────────────────────────────────────────────────────

# Base URL the browser uses to reach the API. In dev the Next.js rewrite
# proxies /api/* to the API, so this stays same-origin.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Set to "true" when the API runs behind a reverse proxy / load balancer,
# so rate limiting sees the real client IP from X-Forwarded-For.
TRUST_PROXY=false
